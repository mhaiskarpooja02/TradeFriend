# core/TradeFriendSwingTradeMonitor.py

from utils.logger import get_logger
from core.TradeFriendDataProvider import TradeFriendDataProvider
from db.TradeFriendTradeRepo import TradeFriendTradeRepo
from Servieces.TradeFriendExitOrderService import TradeFriendExitOrderService
from config.TradeFriendConfig import (
    ALLOW_TRAILING_SL,
    ENABLE_PARTIAL_BOOKING,
    PARTIAL_BOOK_RR,
    SL_BUFFER_PCT,
    HARD_EXIT_R_MULTIPLE,
    TRAIL_ATR_MULTIPLE,
    TRAIL_START_R
)

logger = get_logger(__name__)


class TradeFriendSwingTradeMonitor:
    """
    PURPOSE:
    - Monitor OPEN / PARTIAL swing trades
    - Detect exit conditions
    - Delegate execution & finalization to Exit OMS
    """

    def __init__(self):
        self.provider = TradeFriendDataProvider()
        self.trade_repo = TradeFriendTradeRepo()
        self.exit_oms = TradeFriendExitOrderService()

    # ==================================================
    # PUBLIC ENTRY
    # ==================================================
    def run(self):
        open_trades = self.trade_repo.fetch_open_trades()
        if not open_trades:
            return

        for trade in open_trades:
            try:
                self._process_trade(trade)
            except Exception as e:
                logger.exception(
                    f"SwingTradeMonitor failed for {trade['symbol']}: {e}"
                )

    # ==================================================
    # PROCESS SINGLE TRADE
    # ==================================================
    def _process_trade(self, trade: dict):
        
        # sqlite3.Row → dict safety
        trade = dict(trade)
    
        symbol = trade["symbol"]
        trade_id = trade["id"]
    
        entry = float(trade["entry"])
        sl = float(trade["sl"])
        target = float(trade["target"])
    
        qty = int(trade.get("qty", 0))
        remaining_qty = int(trade.get("remaining_qty", qty))
    
        hold_mode = int(trade.get("hold_mode", 0))   # 0=open, 1=partial, 2=runner
        trailing_sl = trade.get("trailing_sl")
        trailing_sl = float(trailing_sl) if trailing_sl else sl
    
        if remaining_qty <= 0:
            logger.info(f"{symbol} → No qty left, skipping")
            return
    
        # -------------------------------
        # Fetch LTP (ALWAYS LATEST)
        # -------------------------------
        ltp = self.provider.get_ltp_byLtp(symbol)
        if ltp is None:
            logger.warning(f"{symbol} → LTP unavailable")
            return
    
        risk = abs(entry - sl)
        if risk <= 0:
            logger.error(
                f"{symbol} → Invalid risk | entry={entry} sl={sl}"
            )
            return
    
        logger.info(
            f"🔍 MONITOR | {symbol} | "
            f"LTP={ltp} | ENTRY={entry} | SL={sl} | TARGET={target} | "
            f"HOLD={hold_mode} | REM_QTY={remaining_qty}"
        )
    
        # ==================================================
        # 1️⃣ HARD SL (ALWAYS FIRST)
        # ==================================================
        active_sl = max(sl, trailing_sl)
    
        if ltp <= active_sl:
            self._exit(trade, "SL_HIT", remaining_qty, ltp)
            return
    
        # ==================================================
        # 2️⃣ PARTIAL PROFIT @ 1R (ONLY ONCE)
        # ==================================================
        if ENABLE_PARTIAL_BOOKING and hold_mode == 0:
        
            one_r_price = entry + (risk * PARTIAL_BOOK_RR)
    
            if ltp >= one_r_price:
                partial_qty = remaining_qty // 2
    
                if partial_qty > 0:
                    self._exit(trade, "PARTIAL_EXIT", partial_qty, ltp)
    
                    # 🔁 refresh trade after DB update
                    trade = dict(self.trade_repo.get_trade_by_id(trade_id))
                    hold_mode = 1
                    remaining_qty = trade["remaining_qty"]
    
                    logger.info(
                        f"📉 PARTIAL BOOKED | {symbol} | REM_QTY={remaining_qty}"
                    )
                return
    
        # ==================================================
        # 3️⃣ TARGET → CONVERT TO RUNNER (NOT EXIT)
        # ==================================================
        if ltp >= target and hold_mode == 1:
        
            new_sl = target  # lock profits
    
            self.trade_repo.update_sl(trade_id, new_sl)
            self.trade_repo.update_hold_mode(trade_id, 2)
    
            logger.info(
                f"🏁 TARGET HIT → RUNNER | {symbol} | SL moved to {new_sl}"
            )
            return
    
        # ==================================================
        # 4️⃣ RUNNER TRAILING SL (EOD / SAFE MODE)
        # ==================================================
        if ALLOW_TRAILING_SL and hold_mode == 2:
        
            # example: trail only if new structure formed
            new_trailing_sl = max(trailing_sl, ltp * 0.98)
    
            if new_trailing_sl > trailing_sl:
                self.trade_repo.update_sl(trade_id, new_trailing_sl)
    
                logger.info(
                    f"🔒 RUNNER SL TRAILED | {symbol} | "
                    f"{trailing_sl:.2f} → {new_trailing_sl:.2f}"
                )
    
    # ==================================================
    # SINGLE EXIT GATE (DELEGATE ONLY)
    # ==================================================
    def _exit(self, trade: dict, reason: str, qty: int, price: float):
        symbol = trade["symbol"]
        
        # if not self.provider.is_market_open():
        #     self.trade_repo.mark_exit_pending(trade["id"], reason)
        #     logger.warning(f"{symbol} → Exit deferred (market closed)")
        #     return

        # logger.info(
        #     f"🚪 EXIT SIGNAL | {symbol} | Reason={reason} | Qty={qty}"
        # )

        
        self.exit_oms.place_exit_order(
            trade_id=trade["id"],
            symbol=symbol,
            exit_qty=qty,
            exit_reason=reason,
            exit_price=price
        )
